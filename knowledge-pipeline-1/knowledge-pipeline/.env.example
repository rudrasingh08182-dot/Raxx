# Copy this file to ".env" and fill in your actual keys.
# Then load it before running scripts, e.g.:
#   export $(cat .env | xargs)   (Linux/Mac)
# or use python-dotenv in your scripts if you prefer.

# Used for: embeddings during ingestion AND retrieval (must be the SAME model
# both times, so keep this key wired to both embed_and_upload.py and retrieval.py)
GEMINI_API_KEY=gemini key

# Used for: generating the final answer shown to the user (chat_api.py / claude_client.py)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

SUPABASE_URL=xxxxxxx
SUPABASE_SERVICE_KEY=xxxxxxxx